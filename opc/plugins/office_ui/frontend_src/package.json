{
  "name": "openopc-office-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:vitest",
    "test:unit": "node ./tests/run-unit-tests.mjs",
    "test:vitest": "vitest run",
    "test:scroll": "node --import tsx ./tests/message-list-scroll.spec.ts",
    "test:e2e": "node --import tsx ./tests/message-list-scroll.spec.ts && node --import tsx ./tests/exec-panel-scroll.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@xyflow/react": "^12.3.5",
    "easystarjs": "^0.4.4",
    "mdast-util-to-markdown": "^2.1.2",
    "phaser": "^3.90.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^30.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.7",
    "ws": "^8.20.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
